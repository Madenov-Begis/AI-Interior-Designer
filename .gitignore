# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local Google Cloud credentials
/service-account.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local worktrees and tooling
.worktrees/
.superpowers/
.codex-audits/
.trigger/
/src/generated/prisma/
/supabase/.temp/

