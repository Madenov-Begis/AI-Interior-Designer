# Скопировать в /etc/ruvie/runtime.env с правами 0600. Реальных значений в Git нет.
# Compose читает raw: значения записываются без кавычек и подстановок shell.
APP_URL=https://app.example.com
APP_ORIGINS=https://app.example.com
ADMIN_ORIGINS=https://admin.example.com
AUTH_COOKIE_DOMAIN=.example.com
APP_TIMEZONE=Asia/Tashkent
DATABASE_URL=postgresql://ruvie_app:REPLACE_WITH_APP_PASSWORD@postgres:5432/ruvie
DIRECT_URL=postgresql://ruvie_app:REPLACE_WITH_APP_PASSWORD@postgres:5432/ruvie
AUTH_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_OAUTH_CALLBACK_URL=https://app.example.com/auth/callback
STORAGE_PUBLIC_ORIGIN=https://app.example.com
STORAGE_SIGNING_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARS
ADMIN_ACCESS_CODE=REPLACE_WITH_RANDOM_ADMIN_CODE
ADMIN_TOKEN_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARS
AI_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT_ID=REPLACE_WITH_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
# Включить после проверки реальной генерации на тестовом VPS.
GENERATIONS_ENABLED=false
PAYMENT_PROVIDER=disabled
WORKER_CONCURRENCY=1
MAX_PARALLEL_GENERATIONS=1
