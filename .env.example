NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Ruvie
APP_URL=https://ruvie.cc
APP_ORIGINS=https://ruvie.cc,https://www.ruvie.cc
APP_TIMEZONE=Asia/Tashkent
MAX_PARALLEL_GENERATIONS=1
MAX_REFERENCE_IMAGES=10
MAX_REFERENCE_URLS=10
MAX_UPLOAD_SIZE_MB=15
MAX_OUTPUT_WIDTH=4096
MAX_OUTPUT_HEIGHT=4096
NEXT_PUBLIC_API_BASE_URL=https://api.ruvie.cc
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=.ruvie.cc
AUTH_COOKIE_DOMAIN=.ruvie.cc

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
ADMIN_ORIGINS=https://admin.ruvie.cc
# ADMIN_PHONE_E164=+998901234567
# Required in production. Generate unique secrets; do not reuse these examples.
ADMIN_ACCESS_CODE=minimum-5-characters
ADMIN_TOKEN_SECRET=generate-a-random-secret-with-at-least-32-characters

DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:54322/postgres

AI_PROVIDER=vertex
# Emergency kill switch. Set to false in hosting and redeploy to reject every
# new root generation, refinement, and retry with HTTP 503.
GENERATIONS_ENABLED=true
# Production default: purchases stay disabled until a Payme/Click adapter and
# merchant contract exist. For local development only, use PAYMENT_PROVIDER=mock
# together with AI_PROVIDER=fake.
PAYMENT_PROVIDER=disabled
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
# Production on Vercel: keyless authentication through Workload Identity
# Federation. These values are identifiers, not secrets.
GCP_PROJECT_NUMBER=123456789012
GCP_SERVICE_ACCOUNT_EMAIL=ruvie-vertex@your-google-cloud-project-id.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel-ruvie-production
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
# Local fallback only. Do not store service-account JSON in Git or Vercel.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"your-google-cloud-project-id","private_key":"replace-me","client_email":"replace-me"}
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
VERTEX_IMAGE_MODEL=gemini-3-pro-image
# Text-capable multimodal model used to validate source photos before upload.
VERTEX_IMAGE_VALIDATION_MODEL=gemini-2.5-flash

# TRIGGER_SECRET_KEY=your-trigger-secret
# SENTRY_DSN=https://public-key@example.ingest.sentry.io/project-id

# Optional error reporting; events are scrubbed before sending.
# SENTRY_DSN=https://public-key@your-ingest.sentry.io/project-id
# NEXT_PUBLIC_SENTRY_DSN=https://public-key@your-ingest.sentry.io/project-id
# Admin uses VITE_SENTRY_DSN in its own environment.
