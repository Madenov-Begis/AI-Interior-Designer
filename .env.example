# ==============================================================================
# Ruvie — Переменные окружения (.env.example)
# ==============================================================================
# Скопируйте в .env:
#   cp .env.example .env
# Сгенерируйте криптостойкие секреты:
#   pnpm env:secrets .env
# Запустите проект в Docker:
#   docker compose up -d --build
# ==============================================================================

NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Ruvie
APP_TIMEZONE=Asia/Tashkent

# Публичные адреса приложения и админки (для продакшена укажите ваши домены)
APP_URL=http://localhost:3000
APP_ORIGINS=http://localhost:3000
ADMIN_ORIGINS=http://localhost:8080
STORAGE_PUBLIC_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# AUTH_COOKIE_DOMAIN=.example.com  # Раскомментируйте для общего cookie между доменами

# База данных PostgreSQL в Docker
POSTGRES_DB=ruvie
POSTGRES_USER=ruvie
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgresql://ruvie:replace-with-a-strong-postgres-password@postgres:5432/ruvie
DIRECT_URL=postgresql://ruvie:replace-with-a-strong-postgres-password@postgres:5432/ruvie
DATABASE_SSL_MODE=disable

# Криптостойкие секреты (минимум 32 символа, автогенерация: pnpm env:secrets .env)
AUTH_SESSION_SECRET=replace-with-unique-auth-session-secret-at-least-32-chars
STORAGE_SIGNING_SECRET=replace-with-unique-storage-signing-secret-at-least-32-chars
ADMIN_TOKEN_SECRET=replace-with-unique-admin-token-secret-at-least-32-chars
ADMIN_ACCESS_CODE=replace-with-admin-access-code

# Хранилище медиафайлов (в Docker смонтировано в volume media_data)
STORAGE_ROOT=/data/media

# Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: https://yourdomain.com/auth/callback (или http://localhost:3000/auth/callback)
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Генерация AI (vertex для продакшена с Google Cloud, fake для тестирования)
AI_PROVIDER=fake
GENERATIONS_ENABLED=true
GOOGLE_CLOUD_PROJECT_ID=replace-with-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# JSON ключ сервисного аккаунта GCP (одной строкой):
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Либо путь к JSON-файлу сервисного аккаунта:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Платежи (disabled для запуска без платежей, mock для тестирования)
PAYMENT_PROVIDER=disabled

# Параметры воркера генераций
WORKER_CONCURRENCY=2
MAX_PARALLEL_GENERATIONS=2

# Sentry (необязательно)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
