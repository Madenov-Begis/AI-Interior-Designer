# Локальная разработка с новой пустой PostgreSQL. Секреты ниже замените своими.
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Ruvie
APP_URL=http://localhost:3000
APP_ORIGINS=http://localhost:3000
ADMIN_ORIGINS=http://localhost:5173
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Tashkent
DATABASE_URL=postgresql://ruvie_test:local-test-only@127.0.0.1:55432/ruvie_refactor_test
DIRECT_URL=postgresql://ruvie_test:local-test-only@127.0.0.1:55432/ruvie_refactor_test
DATABASE_SSL_MODE=disable
AUTH_SESSION_SECRET=replace-with-a-unique-secret-at-least-32-characters
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback
STORAGE_ROOT=/tmp/ruvie-local-media
STORAGE_PUBLIC_ORIGIN=http://localhost:3000
STORAGE_SIGNING_SECRET=replace-with-another-unique-secret-at-least-32-characters
ADMIN_ACCESS_CODE=replace-with-admin-code
ADMIN_TOKEN_SECRET=replace-with-admin-secret-at-least-32-characters
AI_PROVIDER=fake
GENERATIONS_ENABLED=true
PAYMENT_PROVIDER=mock
WORKER_CONCURRENCY=1
MAX_PARALLEL_GENERATIONS=1
# Для Vertex на сервере: AI_PROVIDER=vertex, GOOGLE_CLOUD_PROJECT_ID и
# GOOGLE_APPLICATION_CREDENTIALS с путём к файлу вне репозитория.
# SENTRY_DSN и NEXT_PUBLIC_SENTRY_DSN необязательны.
