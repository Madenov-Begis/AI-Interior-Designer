{
  "name": "ruvie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "admin:dev": "pnpm --dir admin dev",
    "admin:test": "pnpm --dir admin test",
    "admin:server:test": "node --test --experimental-strip-types src/server/features/admin/admin.test.ts",
    "api-config:test": "node --test --experimental-strip-types src/client/shared/api/url.test.ts src/server/shared/security/cors.test.ts",
    "admin:typecheck": "pnpm --dir admin typecheck",
    "admin:build": "pnpm --dir admin build",
    "admin:seed": "node --experimental-strip-types scripts/seed-admin.ts",
    "build": "prisma generate && next build",
    "recover:generations": "node --experimental-strip-types scripts/recover-generation-reservations.ts",
    "release:check": "pnpm legal:check && pnpm prisma:validate && pnpm test && pnpm test:ui && pnpm typecheck && pnpm lint && pnpm build && pnpm admin:test && pnpm admin:server:test && pnpm admin:typecheck && pnpm admin:build && git diff HEAD --check",
    "legal:check": "node scripts/check-legal-documents.mjs",
    "start": "next start",
    "postinstall": "prisma generate",
    "auth:test": "node --test --experimental-strip-types src/client/features/auth/model/current-user.test.ts src/client/features/auth/model/route-policy.test.ts src/server/features/auth/route-policy.test.ts",
    "test:ui": "vitest run",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "maintain:storage": "node --experimental-strip-types scripts/maintain-storage.ts",
    "test:integration": "node --test --experimental-strip-types tests/integration/*.test.ts",
    "docker:db:up": "docker compose -f compose.test.yaml up -d --wait",
    "docker:build": "docker compose -f compose.test.yaml -f compose.preview.yaml build web worker admin",
    "docker:up": "docker compose --env-file .env.local -f compose.test.yaml -f compose.preview.yaml up --build -d --wait",
    "docker:down": "docker compose -f compose.test.yaml -f compose.preview.yaml down --remove-orphans",
    "docker:test": "npm run docker:up && node scripts/test-timeweb-database.mjs",
    "build:preview": "node scripts/build-timeweb-preview.mjs",
    "worker:build": "esbuild scripts/generation-worker.ts --bundle --platform=node --target=node24 --format=esm --packages=external --alias:server-only=./scripts/server-only-worker.ts --outfile=build/worker/generation.mjs",
    "worker:start": "node build/worker/generation.mjs",
    "worker:ops:build": "esbuild scripts/maintain-storage.ts scripts/recover-generation-reservations.ts --bundle --platform=node --target=node24 --format=esm --packages=external --alias:server-only=./scripts/server-only-worker.ts --outdir=build/worker"
  },
  "dependencies": {
    "jose": "6.2.8",
    "@erase2d/fabric": "1.2.1",
    "@google/genai": "2.13.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nextjs": "^10.73.0",
    "@tanstack/react-query": "5.101.3",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fabric": "7.4.0",
    "file-type": "^22.0.1",
    "google-auth-library": "10.9.0",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.25.0",
    "marked": "18.0.11",
    "next": "16.2.10",
    "next-intl": "^4.14.5",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-joyride": "3.2.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "undici": "8.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "16.3.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "26.1.0",
    "prettier": "^3.9.6",
    "prisma": "^7.8.0",
    "shadcn": "4.16.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "3.2.7"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3"
  }
}
