{
  "name": "ruvie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "admin:dev": "pnpm --dir admin dev",
    "admin:test": "pnpm --dir admin test",
    "admin:server:test": "node --test --experimental-strip-types src/server/features/admin/admin.test.ts",
    "api-config:test": "node --test --experimental-strip-types src/client/shared/api/url.test.ts src/server/shared/security/cors.test.ts",
    "admin:typecheck": "pnpm --dir admin typecheck",
    "admin:build": "pnpm --dir admin build",
    "admin:seed": "node --experimental-strip-types scripts/seed-admin.ts",
    "build": "prisma generate && next build",
    "release:check": "pnpm prisma:validate && pnpm test && pnpm typecheck && pnpm lint && pnpm build && pnpm admin:test && pnpm admin:server:test && pnpm admin:typecheck && pnpm admin:build && pnpm db:status && git diff HEAD --check",
    "start": "next start",
    "postinstall": "prisma generate",
    "auth:test": "node --test --experimental-strip-types src/client/features/auth/model/current-user.test.ts src/client/features/auth/model/route-policy.test.ts src/server/features/auth/route-policy.test.ts",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@erase2d/fabric": "1.2.1",
    "@google/genai": "2.13.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@tanstack/react-query": "5.101.3",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fabric": "7.4.0",
    "file-type": "^22.0.1",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-joyride": "3.2.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "undici": "8.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.9.6",
    "prisma": "^7.8.0",
    "shadcn": "4.16.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3"
  }
}
